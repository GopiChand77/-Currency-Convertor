# =============================================================
# HOW TO GET YOUR FREE API KEY:
# 1. Visit https://www.frankfurter.app/ — NO KEY REQUIRED (free, open, no signup)
#    This app uses Frankfurter by default (ECB data, always free).
#
# OPTIONAL — For higher limits / more currencies, use ExchangeRate-API:
# 1. Go to https://www.exchangerate-api.com/
# 2. Click "Get Free Key"
# 3. Sign up with your email (free plan = 1,500 requests/month)
# 4. Paste key below and set USE_FRANKFURTER=false in server.js
# =============================================================

EXCHANGE_RATE_API_KEY=your_api_key_here
PORT=5000
